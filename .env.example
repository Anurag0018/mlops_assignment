# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_db
DB_USER=postgres
DB_PASSWORD=postgres

# Database URL (SQLAlchemy compatible)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/student_db
# For SQLite fallback: sqlite:///data/student_performance.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_db

# Pipeline Data Directories
RAW_DATA_DIR=data/raw
STAGING_DATA_DIR=data/staging
CLEANED_DATA_DIR=data/cleaned
REJECTED_DATA_DIR=data/rejected

# Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
